generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

// ── Users ────────────────────────────────────────────────────────────
// Manual authentication with password
model User {
    id        String   @id @default(uuid())
    email     String   @unique
    password  String
    name      String?
    fcmToken  String?  // Firebase push token
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    addictions Addiction[]
    relapses   Relapse[]
    checkins   Checkin[]
    aiMessages AiMessage[]
    communityMembers CommunityMember[]
    messages         CommunityMessage[]
    moderationFlags  ModerationFlag[]

    @@index([email])
}

// ── Addictions ───────────────────────────────────────────────────────
model Addiction {
    id        String          @id @default(uuid())
    userId    String
    type      String          // "smoking" | "porn" | "alcohol" | "social_media" | "custom"
    goal      String          // "quit" | "reduce"
    triggers  Json            // string[] — flexible, no join table needed
    startDate DateTime        @default(now())
    status    AddictionStatus @default(ACTIVE)
    metadata  Json?           // future-proof: { customType, targetDate, notes }
    createdAt DateTime        @default(now())
    updatedAt DateTime        @updatedAt

    user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    relapses Relapse[]

    @@index([userId])
}

enum AddictionStatus {
    ACTIVE
    PAUSED
    COMPLETED
}

// ── Relapses ─────────────────────────────────────────────────────────
// Logged when user slips — AI uses this for pattern detection
model Relapse {
    id           String   @id @default(uuid())
    userId       String
    addictionId  String
    trigger      String   // what caused it
    mood         String   // "anxious" | "bored" | "stressed" | "sad" | "angry"
    intensity    Int      // 1–10 urge scale
    note         String?  // optional user reflection
    occurredAt   DateTime @default(now())
    context      Json?    // { location, timeOfDay, wasAlone } — optional enrichment

    user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    addiction Addiction @relation(fields: [addictionId], references: [id], onDelete: Cascade)

    @@index([userId, occurredAt])
    @@index([addictionId])
}

// ── Check-ins ────────────────────────────────────────────────────────
// Daily mood + relapse status snapshot
model Checkin {
    id          String   @id @default(uuid())
    userId      String
    mood        String   // "great" | "good" | "okay" | "bad" | "terrible"
    moodScore   Int      // 1–5 numeric for chart rendering
    note        String?
    didRelapse  Boolean  @default(false)
    streak      Int      // streak in days at time of check-in (denormalized for speed)
    checkedAt   DateTime @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, checkedAt]) // one check-in per user per timestamp
    @@index([userId, checkedAt])
}

// ── AI Messages ──────────────────────────────────────────────────────
// Stores coach chat + urge intervention history
model AiMessage {
    id        String      @id @default(uuid())
    userId    String
    role      MessageRole // "user" | "assistant"
    content   String
    context   Json?       // { streak, mood, addiction, trigger } snapshot at time of message
    type      MessageType @default(COACH)
    createdAt DateTime    @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId, createdAt])
    @@index([userId, type])
}

enum MessageRole {
    user
    assistant
}

enum MessageType {
    COACH        // regular AI coach conversation
    URGE         // "I have an urge" intervention
    INSIGHT      // AI-generated pattern insight
}

// ── Communities ──────────────────────────────────────────────────────
// One community per addiction type — seeded at startup, not user-created.
model Community {
    id           String   @id @default(uuid())
    addictionType String  @unique // "smoking" | "alcohol" | etc. — matches Addiction.type
    name         String            // "Quit Smoking Together"
    description  String?
    createdAt    DateTime @default(now())

    members  CommunityMember[]
    messages CommunityMessage[]

    @@index([addictionType])
}

// ── Community Members ────────────────────────────────────────────────
// Tracks who has joined — auto-joined when user creates an ACTIVE addiction.
model CommunityMember {
    id          String   @id @default(uuid())
    userId      String
    communityId String
    joinedAt    DateTime @default(now())

    user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

    @@unique([userId, communityId]) // one membership per community per user
    @@index([communityId])
    @@index([userId])
}

// ── Community Messages ───────────────────────────────────────────────
model CommunityMessage {
    id          String        @id @default(uuid())
    communityId String
    userId      String
    content     String        @db.Text
    status      MessageStatus @default(VISIBLE)
    createdAt   DateTime      @default(now())

    community Community        @relation(fields: [communityId], references: [id], onDelete: Cascade)
    user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
    flags     ModerationFlag[]

    @@index([communityId, createdAt])
    @@index([userId])
}

enum MessageStatus {
    VISIBLE        // normal
    FLAGGED        // under review — still visible to sender, hidden to others
    HIDDEN         // moderation decision: removed
}

// ── Moderation Flags ─────────────────────────────────────────────────
model ModerationFlag {
    id        String     @id @default(uuid())
    messageId String
    flaggedBy String     // userId who reported, or "system" for auto-flags
    reason    FlagReason
    createdAt DateTime   @default(now())

    message CommunityMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
    user    User             @relation(fields: [flaggedBy], references: [id], onDelete: Cascade)

    @@index([messageId])
}

enum FlagReason {
    SPAM
    HATE_SPEECH
    SELF_HARM
    AUTO_KEYWORD  // flagged by the moderation worker
}